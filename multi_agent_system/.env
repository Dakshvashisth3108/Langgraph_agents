# ---------------------------------------------------------------
# .env — environment configuration for the multi-agent system.
# Copy this file as-is to get started; tweak values as needed.
# ---------------------------------------------------------------

# Name of the Ollama model to use.
OLLAMA_MODEL=qwen3:8b

# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# (Optional) Default LLM sampling parameters — agents can still
# override these at call time by passing arguments to get_llm().
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# (Optional) Health-check timeout (seconds) and log level.
OLLAMA_HEALTH_TIMEOUT=3.0
LOG_LEVEL=INFO

# (Optional) LangSmith tracing — leave blank to disable.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi_agent_system
